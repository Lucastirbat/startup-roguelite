; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Startup Simulator 2.0"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.09, 0.1, 0.13, 1)
boot_splash/image="res://assets/graphics/cover_start.png"
boot_splash/fullsize=false
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/GameState.gd"
Audio="*res://scripts/Audio.gd"
Leaderboard="*res://scripts/Leaderboard.gd"

[display]

window/size/viewport_width=600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom="res://theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
